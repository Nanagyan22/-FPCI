            </select>
          </div>
        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title"><i class="fas fa-users"></i> Attendance & Membership</div>
        <div class="form-row four">
          <div class="form-group"><label class="form-label">Male <span class="required">*</span></label><input type="number" name="membershipMale" class="form-control" min="0" required placeholder="0"></div>
          <div class="form-group"><label class="form-label">Female <span class="required">*</span></label><input type="number" name="membershipFemale" class="form-control" min="0" required placeholder="0"></div>
          <div class="form-group"><label class="form-label">Children <span class="required">*</span></label><input type="number" name="membershipChildren" class="form-control" min="0" required placeholder="0"></div>
          <div class="form-group"><label class="form-label">Visitors <span class="required">*</span></label><input type="number" name="membershipVisitors" class="form-control" min="0" required placeholder="0"></div>
