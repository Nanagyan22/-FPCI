<div class="sidebar-overlay" id="sidebarOverlay"></div>
<header class="topbar">
  <div class="topbar-left">
    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle menu">
      <i class="fas fa-bars"></i>
    </button>
    <div>
      <div class="page-title">
        <%= typeof pageTitle !== 'undefined' ? pageTitle : 'FPCI Dashboard' %>
      </div>
      <div class="page-subtitle">
        <%= typeof pageSubtitle !== 'undefined' ? pageSubtitle : 'Flames of Power Chapel International' %>
      </div>
    </div>
  </div>
  <div class="topbar-right">
    <span style="font-size:12px;color:#8a6050;display:none;" class="d-lg-flex">
      <i class="fas fa-calendar-alt" style="color:var(--primary);margin-right:5px;"></i>
      <%= new Date().toLocaleDateString('en-GB',{weekday:'short',year:'numeric',month:'short',day:'numeric'}) %>
    </span>
    <a href="/forms" class="btn btn-primary btn-sm">
      <i class="fas fa-plus"></i> <span>New Report</span>
    </a>
  </div>
</header>
