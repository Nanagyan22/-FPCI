          </div>
          <div class="form-group">
            <label class="form-label">Branch <span class="required">*</span></label>
            <select name="branch" id="monthlyBranch" class="form-control" required onchange="loadPastors(this.value,'monthly')">
              <option value="">-- Select Branch --</option>
              <%if(typeof branches!=='undefined'){branches.forEach(function(b){%>
                <option value="<%= b._id %>"><%= b.name %></option>
