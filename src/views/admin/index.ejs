<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel - FPCI</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-wrapper">
  <nav class="sidebar" id="sidebar">
    <a href="/dashboard" class="sidebar-brand">
      <img src="/images/logo.png" alt="FPCI Logo" onerror="this.style.display='none'">
      <div class="sidebar-brand-text">
        <div class="title">FPCI</div>
        <div class="subtitle">Flames Generation</div>
      </div>
    </a>
    <div class="sidebar-nav">
      <div class="nav-section-title">Main</div>
      <div class="nav-item"><a href="/dashboard" class="nav-link"><i class="fas fa-chart-line"></i><span>Dashboard</span></a></div>
      <div class="nav-item"><a href="/forms" class="nav-link"><i class="fas fa-file-alt"></i><span>Submit Report</span></a></div>
      <div class="nav-item"><a href="/reports" class="nav-link"><i class="fas fa-table"></i><span>Raw Data</span></a></div>
      <div class="nav-section-title">Management</div>
      <div class="nav-item"><a href="/branches" class="nav-link"><i class="fas fa-church"></i><span>Branches</span></a></div>
      <div class="nav-item"><a href="/admin/pastors" class="nav-link"><i class="fas fa-user-tie"></i><span>Pastors</span></a></div>
      <div class="nav-section-title">Admin</div>
      <div class="nav-item"><a href="/admin/links" class="nav-link"><i class="fas fa-link"></i><span>Form Links</span></a></div>
      <div class="nav-item"><a href="/admin/users" class="nav-link"><i class="fas fa-users-cog"></i><span>Users</span></a></div>
      <div class="nav-item"><a href="/admin" class="nav-link active"><i class="fas fa-cog"></i><span>Admin Panel</span></a></div>
    </div>
    <div class="sidebar-footer">
      <div class="user-info">
        <div class="user-avatar"><%= user ? user.firstName.charAt(0) + user.lastName.charAt(0) : 'A' %></div>
        <div class="user-info-text" style="flex:1;">
          <div class="name"><%= user ? user.firstName + ' ' + user.lastName : 'Admin' %></div>
          <div class="role"><%= user ? user.role.replace('_',' ') : 'admin' %></div>
        </div>
        <a href="/auth/logout" style="color:rgba(255,204,0,0.5);font-size:16px;"><i class="fas fa-sign-out-alt"></i></a>
      </div>
    </div>
  </nav>

  <div class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <div>
          <div class="page-title">Admin Panel</div>
          <div class="page-subtitle">System Overview & Management</div>
        </div>
      </div>
      <div class="topbar-right">
        <a href="/forms" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New Report</a>
      </div>
    </header>

    <div class="content-wrapper">
      <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success_msg %></div>
      <% } %>
      <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error_msg %></div>
      <% } %>

      <!-- STAT CARDS -->
      <div class="kpi-grid" style="margin-bottom:24px;">
        <div class="kpi-card blue">
          <div class="kpi-header">
            <div class="kpi-icon blue"><i class="fas fa-users-cog"></i></div>
          </div>
          <div class="kpi-value"><%= users.length %></div>
          <div class="kpi-label">System Users</div>
        </div>
        <div class="kpi-card red">
          <div class="kpi-header">
            <div class="kpi-icon red"><i class="fas fa-church"></i></div>
          </div>
          <div class="kpi-value"><%= branches.length %></div>
          <div class="kpi-label">Total Branches</div>
        </div>
        <div class="kpi-card gold">
          <div class="kpi-header">
            <div class="kpi-icon gold"><i class="fas fa-user-tie"></i></div>
          </div>
          <div class="kpi-value"><%= pastors.length %></div>
          <div class="kpi-label">Registered Pastors</div>
        </div>
        <div class="kpi-card green">
          <div class="kpi-header">
            <div class="kpi-icon green"><i class="fas fa-link"></i></div>
          </div>
          <div class="kpi-value"><%= formLinks.filter(function(f){ return f.isActive; }).length %></div>
          <div class="kpi-label">Active Form Links</div>
        </div>
      </div>

      <!-- QUICK LINKS -->
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px;">
        <a href="/admin/users" class="chart-card" style="text-decoration:none;text-align:center;padding:28px;transition:all 0.3s;">
          <i class="fas fa-users-cog" style="font-size:32px;color:var(--primary);margin-bottom:12px;display:block;"></i>
          <div style="font-weight:700;color:#1a0a03;margin-bottom:4px;">User Management</div>
          <div style="font-size:12px;color:#8a6050;">Manage system access & roles</div>
        </a>
        <a href="/admin/pastors" class="chart-card" style="text-decoration:none;text-align:center;padding:28px;transition:all 0.3s;">
          <i class="fas fa-user-tie" style="font-size:32px;color:var(--gold);margin-bottom:12px;display:block;"></i>
          <div style="font-weight:700;color:#1a0a03;margin-bottom:4px;">Pastors Management</div>
          <div style="font-size:12px;color:#8a6050;">Register & manage pastors</div>
        </a>
        <a href="/admin/links" class="chart-card" style="text-decoration:none;text-align:center;padding:28px;transition:all 0.3s;">
          <i class="fas fa-link" style="font-size:32px;color:#0284c7;margin-bottom:12px;display:block;"></i>
          <div style="font-weight:700;color:#1a0a03;margin-bottom:4px;">Form Links</div>
          <div style="font-size:12px;color:#8a6050;">Generate shareable form links</div>
        </a>
      </div>

      <!-- USERS & LINKS PANELS -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div class="chart-card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <div class="chart-title"><i class="fas fa-users" style="color:var(--primary);"></i> Recent Users</div>
            <a href="/admin/users" class="btn btn-secondary btn-sm">Manage All</a>
          </div>
          <% users.slice(0,6).forEach(function(u) { %>
          <div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #f5ede8;">
            <div class="user-avatar" style="width:36px;height:36px;font-size:12px;background:linear-gradient(135deg,var(--primary),var(--fire-orange));color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;">
              <%= u.firstName.charAt(0) %><%= u.lastName.charAt(0) %>
            </div>
            <div style="flex:1;">
              <div style="font-weight:600;font-size:13px;"><%= u.firstName %> <%= u.lastName %></div>
              <div style="font-size:11px;color:#8a6050;"><%= u.email %></div>
            </div>
            <span class="status-badge <%= u.role === 'super_admin' ? 'approved' : u.role === 'admin' ? 'pending' : 'rejected' %>" style="font-size:10px;">
              <%= u.role.replace('_',' ') %>
            </span>
          </div>
          <% }) %>
        </div>

        <div class="chart-card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <div class="chart-title"><i class="fas fa-link" style="color:var(--gold);"></i> Recent Form Links</div>
            <a href="/admin/links" class="btn btn-secondary btn-sm">View All</a>
          </div>
          <% formLinks.slice(0,5).forEach(function(link) { %>
          <div style="padding:10px 0;border-bottom:1px solid #f5ede8;font-size:13px;">
            <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
              <span style="font-weight:600;text-transform:capitalize;"><%= link.formType %> Form</span>
              <% var isActive = link.isActive && new Date(link.expiresAt) > new Date(); %>
              <span class="status-badge <%= isActive ? 'approved' : 'rejected' %>" style="font-size:10px;">
                <%= isActive ? 'Active' : 'Expired' %>
              </span>
            </div>
            <div style="color:#8a6050;font-size:11px;">
              <%= link.branch ? link.branch.name : 'All Branches' %> &middot;
              Used: <%= link.usageCount %>x
            </div>
          </div>
          <% }) %>
          <a href="/admin/links" class="btn btn-primary btn-sm" style="margin-top:12px;display:inline-flex;">
            <i class="fas fa-plus"></i> Generate New Link
          </a>
        </div>
      </div>

    </div>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
