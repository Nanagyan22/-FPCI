            <div class="signature-wrapper">
              <canvas id="monthlyPastorSig" class="signature-pad" width="380" height="100"></canvas>
              <div class="signature-actions">
                <button type="button" class="btn btn-secondary btn-sm" onclick="clearSig('monthlyPastorSig','monthlyPastorSigData')"><i class="fas fa-eraser"></i> Clear</button>
                <span style="font-size:11px;color:#8a6050;">Sign above</span>
              </div>
            </div>
            <input type="hidden" name="residentPastorSignature" id="monthlyPastorSigData">
