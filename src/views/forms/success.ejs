<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Report Submitted - FPCI</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body style="background:linear-gradient(135deg,#faf5f0,#f5ede8);min-height:100vh;display:flex;align-items:center;justify-content:center;">
  <div style="background:white;border-radius:20px;padding:48px;max-width:480px;width:90%;box-shadow:0 20px 60px rgba(171,42,10,0.15);text-align:center;border-top:6px solid #16a34a;">
    <div style="width:80px;height:80px;background:rgba(22,163,74,0.1);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:36px;">
      ✅
    </div>
    <h1 style="color:#16a34a;font-size:26px;font-weight:800;margin-bottom:8px;">Report Submitted!</h1>
    <p style="color:#4a2a10;margin-bottom:16px;">Your <strong><%= reportType %></strong> report has been submitted successfully.</p>
    <div style="background:#f5ede8;border-radius:10px;padding:16px;margin-bottom:24px;">
      <div style="font-size:12px;color:#8a6050;margin-bottom:4px;">Report Reference ID</div>
      <div style="font-family:monospace;font-size:16px;font-weight:700;color:var(--primary)"><%= reportId %></div>
    </div>
    <p style="font-size:13px;color:#8a6050;margin-bottom:24px;">The data has been recorded and will reflect in the dashboard. Thank you for your faithful reporting.</p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <button onclick="window.history.back()" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Submit Another
      </button>
      <a href="/" class="btn btn-primary">
        <i class="fas fa-home"></i> Go to Dashboard
      </a>
    </div>
    <div style="margin-top:24px;padding-top:20px;border-top:1px solid #f0e8e0;">
      <img src="/images/logo.png" alt="FPCI" style="width:40px;height:40px;border-radius:50%;border:2px solid #D4AF37;" onerror="this.style.display='none'">
      <p style="font-size:11px;color:#c4a98a;margin-top:8px;">Flames of Power Chapel International</p>
    </div>
  </div>
</body>
</html>
