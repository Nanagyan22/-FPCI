<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Management - FPCI</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-wrapper">
  <nav class="sidebar" id="sidebar">
    <a href="/dashboard" class="sidebar-brand">
      <img src="/images/logo.png" alt="FPCI" onerror="this.style.display='none'">
      <div class="sidebar-brand-text">
        <div class="title">FPCI</div>
        <div class="subtitle">Flames Generation</div>
      </div>
    </a>
    <div class="sidebar-nav">
      <div class="nav-section-title">Main</div>
      <div class="nav-item"><a href="/dashboard" class="nav-link"><i class="fas fa-chart-line"></i><span>Dashboard</span></a></div>
      <div class="nav-item"><a href="/forms" class="nav-link"><i class="fas fa-file-alt"></i><span>Submit Report</span></a></div>
      <div class="nav-item"><a href="/reports" class="nav-link"><i class="fas fa-table"></i><span>Raw Data</span></a></div>
      <div class="nav-section-title">Management</div>
      <div class="nav-item"><a href="/branches" class="nav-link"><i class="fas fa-church"></i><span>Branches</span></a></div>
      <div class="nav-item"><a href="/admin/pastors" class="nav-link"><i class="fas fa-user-tie"></i><span>Pastors</span></a></div>
      <div class="nav-section-title">Admin</div>
      <div class="nav-item"><a href="/admin/links" class="nav-link"><i class="fas fa-link"></i><span>Form Links</span></a></div>
      <div class="nav-item"><a href="/admin/users" class="nav-link active"><i class="fas fa-users-cog"></i><span>Users</span></a></div>
      <div class="nav-item"><a href="/admin" class="nav-link"><i class="fas fa-cog"></i><span>Admin Panel</span></a></div>
    </div>
    <div class="sidebar-footer">
      <div class="user-info">
        <div class="user-avatar"><%= user ? user.firstName.charAt(0) + user.lastName.charAt(0) : 'A' %></div>
        <div class="user-info-text" style="flex:1;">
          <div class="name"><%= user ? user.firstName + ' ' + user.lastName : 'Admin' %></div>
          <div class="role"><%= user ? user.role.replace('_',' ') : 'admin' %></div>
        </div>
        <a href="/auth/logout" style="color:rgba(255,204,0,0.5);font-size:16px;"><i class="fas fa-sign-out-alt"></i></a>
      </div>
    </div>
  </nav>

  <div class="main-content">
    <header class="topbar">
      <div class="topbar-left">
        <div>
          <div class="page-title">User Management</div>
          <div class="page-subtitle">Manage system access and permissions</div>
        </div>
      </div>
      <div class="topbar-right">
        <a href="/admin" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Admin Panel</a>
      </div>
    </header>

    <div class="content-wrapper">
      <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success_msg %></div>
      <% } %>
      <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error_msg %></div>
      <% } %>

      <div style="display:grid;grid-template-columns:340px 1fr;gap:24px;align-items:start;">

        <!-- ADD USER FORM -->
        <div class="chart-card">
          <div class="chart-title" style="margin-bottom:20px;">
            <i class="fas fa-user-plus" style="color:var(--primary);"></i> Add New User
          </div>
          <form action="/admin/users/add" method="POST">
            <div class="form-group" style="margin-bottom:12px;">
              <label class="form-label">First Name <span class="required">*</span></label>
              <input type="text" name="firstName" class="form-control" required placeholder="First name">
            </div>
            <div class="form-group" style="margin-bottom:12px;">
              <label class="form-label">Last Name <span class="required">*</span></label>
              <input type="text" name="lastName" class="form-control" required placeholder="Last name">
            </div>
            <div class="form-group" style="margin-bottom:12px;">
              <label class="form-label">Email Address <span class="required">*</span></label>
              <input type="email" name="email" class="form-control" required placeholder="user@fpci.org">
            </div>
            <div class="form-group" style="margin-bottom:12px;">
              <label class="form-label">Password <span class="required">*</span></label>
              <input type="password" name="password" class="form-control" required minlength="6" placeholder="Min 6 characters">
            </div>
            <div class="form-group" style="margin-bottom:12px;">
              <label class="form-label">Role</label>
              <select name="role" class="form-control">
                <option value="viewer">Viewer (Read only)</option>
                <option value="branch_admin">Branch Admin</option>
                <option value="admin">Admin</option>
                <option value="super_admin">Super Admin</option>
              </select>
            </div>
            <div class="form-group" style="margin-bottom:18px;">
              <label class="form-label">Assign Branch (optional)</label>
              <select name="branch" class="form-control">
                <option value="">No specific branch</option>
                <% branches.forEach(function(b) { %>
                  <option value="<%= b._id %>"><%= b.name %></option>
                <% }) %>
              </select>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">
              <i class="fas fa-user-plus"></i> Add User
            </button>
          </form>
        </div>

        <!-- USERS TABLE -->
        <div class="data-table-container">
          <div style="font-size:16px;font-weight:700;color:#1a0a03;margin-bottom:16px;">
            <i class="fas fa-users" style="color:var(--gold);"></i>
            All Users (<%= users.length %>)
          </div>
          <div style="overflow-x:auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Branch</th>
                <th>Status</th>
                <th>Last Login</th>
                <th>Created</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(u) { %>
              <tr>
                <td>
                  <div style="display:flex;align-items:center;gap:10px;">
                    <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--fire-orange));color:white;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;flex-shrink:0;">
                      <%= u.firstName.charAt(0) %><%= u.lastName.charAt(0) %>
                    </div>
                    <span style="font-weight:600;"><%= u.firstName %> <%= u.lastName %></span>
                  </div>
                </td>
                <td style="color:#8a6050;font-size:13px;"><%= u.email %></td>
                <td>
                  <span class="status-badge <%= u.role === 'super_admin' || u.role === 'admin' ? 'approved' : 'pending' %>" style="font-size:10px;text-transform:capitalize;">
                    <%= u.role.replace(/_/g,' ') %>
                  </span>
                </td>
                <td style="font-size:13px;"><%= u.branch ? u.branch.name : '&mdash;' %></td>
                <td>
                  <span class="status-badge <%= u.isActive ? 'approved' : 'rejected' %>">
                    <%= u.isActive ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td style="font-size:12px;color:#8a6050;">
                  <%= u.lastLogin ? new Date(u.lastLogin).toLocaleDateString('en-GB') : 'Never' %>
                </td>
                <td style="font-size:12px;color:#8a6050;">
                  <%= new Date(u.createdAt).toLocaleDateString('en-GB') %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
