      </div>

      <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:28px;flex-wrap:wrap;">
        <button type="button" class="btn btn-secondary" onclick="resetFormFields('monthlyForm')"><i class="fas fa-undo"></i> Reset</button>
        <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-paper-plane"></i> Submit Monthly Report</button>
      </div>
    </form>
  </div>
</div>
</div>

<script>
// =========================================================
// TAB SWITCHER - Simple & Reliable
// =========================================================
function switchFormTab(tab) {
  var wEl = document.getElementById('tab-weekly');
  var mEl = document.getElementById('tab-monthly');
  var wBtn = document.getElementById('btnWeekly');
  var mBtn = document.getElementById('btnMonthly');
  if (!wEl || !mEl) return;
  if (tab === 'monthly') {
    wEl.style.display = 'none';
    mEl.style.display = 'block';
    if(wBtn) wBtn.classList.remove('active');
    if(mBtn) mBtn.classList.add('active');
  } else {
    mEl.style.display = 'none';
    wEl.style.display = 'block';
    if(mBtn) mBtn.classList.remove('active');
    if(wBtn) wBtn.classList.add('active');
  }
  window.scrollTo(0,0);
}

// Set active tab on load
(function(){
  var activeTab = '<%= typeof activeTab !== "undefined" ? activeTab : "weekly" %>';
  switchFormTab(activeTab);
})();

// =========================================================
// CUSTOM FIELD BUILDER
// =========================================================
function addCustomField(containerId, labelName, amountName, calcClass) {
  var container = document.getElementById(containerId);
  var row = document.createElement('div');
  row.className = 'custom-field-row';
  row.innerHTML =
    '<input type="text" name="' + labelName + '" class="form-control" placeholder="Field name e.g. Harvest Offering" required>' +
    '<div class="input-group" style="margin:0;">' +
      '<span class="input-prefix" style="padding:8px 10px;font-size:12px;">GH¢</span>' +
      '<input type="number" name="' + amountName + '" class="form-control financial ' + calcClass + '" min="0" step="0.01" placeholder="0.00">' +
    '</div>' +
    '<button type="button" class="remove-field-btn" onclick="removeCustomField(this)">' +
      '<i class="fas fa-times"></i>' +
    '</button>';
  container.appendChild(row);

  // Attach calc listener
  var numInput = row.querySelector('input[type="number"]');
  numInput.addEventListener('input', calcAll);
}

function removeCustomField(btn) {
  btn.parentElement.remove();
  calcAll();
}

function calcAll() {
  calcWeeklyTotal();
  calcMonthlyTotals();
}
</script>
