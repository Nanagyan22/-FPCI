<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-wrapper">
  <%- include('../partials/sidebar', { currentPage: 'branches', user: user }) %>
  <div class="main-content">
    <%- include('../partials/topbar', { pageTitle: 'Add New Branch', pageSubtitle: 'Register a new FPCI branch' }) %>
    <div class="content-wrapper">
      <div style="max-width:800px;">
        <% if (error_msg && error_msg.length > 0) { %>
          <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error_msg %></div>
        <% } %>
        <div class="form-card">
          <div class="form-body">
            <form action="/branches/add" method="POST">
              <div class="form-section-title"><i class="fas fa-church"></i> Branch Information</div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">Branch Name <span class="required">*</span></label>
                  <input type="text" name="name" class="form-control" required placeholder="e.g. Accra Branch">
                </div>
                <div class="form-group">
                  <label class="form-label">Branch Code <span class="required">*</span></label>
                  <input type="text" name="code" class="form-control" required placeholder="e.g. ACC" maxlength="10" style="text-transform:uppercase;">
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">Location <span class="required">*</span></label>
                  <input type="text" name="location" class="form-control" required placeholder="City/Town">
                </div>
                <div class="form-group">
                  <label class="form-label">Region</label>
                  <input type="text" name="region" class="form-control" placeholder="e.g. Greater Accra">
                </div>
              </div>
              <div class="form-row one">
                <div class="form-group">
                  <label class="form-label">Full Address</label>
                  <input type="text" name="address" class="form-control" placeholder="Street address">
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">Phone</label>
                  <input type="text" name="phone" class="form-control" placeholder="+233...">
                </div>
                <div class="form-group">
                  <label class="form-label">Email</label>
                  <input type="email" name="email" class="form-control" placeholder="branch@fpci.org">
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">Established Date</label>
                  <input type="date" name="establishedDate" class="form-control">
                </div>
                <div class="form-group" style="display:flex;align-items:flex-end;padding-bottom:8px;">
                  <label class="form-check">
                    <input type="checkbox" name="isHeadquarters">
                    <span class="form-check-label" style="font-weight:600;">This is Headquarters</span>
                  </label>
                </div>
              </div>
              <div class="form-section-title" style="margin-top:20px;"><i class="fas fa-user-tie"></i> Assign Pastors</div>
              <div class="form-group">
                <label class="form-label">Select Pastors (can select multiple)</label>
                <select name="pastors" class="form-control" multiple style="height:120px;">
                  <% pastors.forEach(p => { %>
                    <option value="<%= p._id %>"><%= p.title %> <%= p.firstName %> <%= p.lastName %></option>
                  <% }) %>
                </select>
                <small style="color:#8a6050;font-size:12px;">Hold Ctrl/Cmd to select multiple pastors</small>
              </div>
              <div class="form-group">
                <label class="form-label">Description</label>
                <textarea name="description" class="form-control" rows="3" placeholder="Branch description..."></textarea>
              </div>
              <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:20px;">
                <a href="/branches" class="btn btn-secondary"><i class="fas fa-times"></i> Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Add Branch</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
