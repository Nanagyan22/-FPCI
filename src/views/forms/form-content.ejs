        <div class="form-row" style="grid-template-columns:200px 1fr;">
          <div class="form-group"><label class="form-label">Souls Added <span class="required">*</span></label><input type="number" name="soulsAdded" class="form-control" min="0" required placeholder="0"></div>
        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title"><i class="fas fa-coins"></i> Income</div>
        <div class="form-row three">
          <%var mi=[['tithes','Tithes',true],['offerings','Offerings',true],['membershipDues','Membership Dues',true],['projectOffering','Project Offering',false],['childrenService','Children Service',false],['seeds','Seeds',false],['pledges','Pledges',false],['revivalPrograms','Revival/Programs',false],['bank','Bank',false],['otherFunds','Other Funds',false]];%>
          <%mi.forEach(function(f){%>
          <div class="form-group">
            <label class="form-label"><%= f[1] %><%if(f[2]){%> <span class="required">*</span><%}%></label>
            <div class="input-group"><span class="input-prefix">GH¢</span><input type="number" name="<%= f[0] %>" class="form-control financial m-income" min="0" step="0.01" placeholder="0.00"<%if(f[2]){%> required<%}%>></div>
          </div>
          <%})%>
        </div>
        <!-- CUSTOM INCOME -->
        <div style="margin-top:16px;padding-top:16px;border-top:1.5px dashed rgba(22,163,74,0.2);">
          <div style="font-size:13px;font-weight:700;color:#4a2a10;margin-bottom:10px;">
            <i class="fas fa-plus-circle" style="color:#16a34a;"></i> Additional Income Fields
          </div>
          <div id="monthlyCustomIncome"></div>
          <button type="button" class="add-field-btn" style="border-color:rgba(22,163,74,0.3);color:#16a34a;background:rgba(22,163,74,0.06);" onclick="addCustomField('monthlyCustomIncome','customIncomeLabels','customIncomeAmounts','m-income')">
            <i class="fas fa-plus"></i> Add Custom Income Field
          </button>
        </div>
        <div style="background:linear-gradient(135deg,rgba(22,163,74,0.08),rgba(74,222,128,0.04));border-radius:10px;padding:14px 20px;margin-top:14px;display:flex;justify-content:space-between;align-items:center;border:1.5px solid rgba(22,163,74,0.2);">
          <span style="font-weight:700;font-size:14px;"><i class="fas fa-arrow-up" style="color:#16a34a;margin-right:8px;"></i>Total Income</span>
          <span style="font-size:22px;font-weight:900;color:#16a34a;">GH¢ <span id="monthlyIncomeTotal">0.00</span></span>
        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title"><i class="fas fa-receipt"></i> Expenditure</div>
        <div class="form-row three">
          <div class="form-group"><label class="form-label">Light: Church Premises <span class="required">*</span></label><div class="input-group"><span class="input-prefix">GH¢</span><input type="number" name="lightChurchPremises" class="form-control financial m-expense" min="0" step="0.01" placeholder="0.00" required></div></div>
          <div class="form-group"><label class="form-label">Pastors Allowance <span class="required">*</span></label><div class="input-group"><span class="input-prefix">GH¢</span><input type="number" name="pastorsAllowance" class="form-control financial m-expense" min="0" step="0.01" placeholder="0.00" required></div></div>
          <div class="form-group"><label class="form-label">Other Expenses <span class="required">*</span></label><div class="input-group"><span class="input-prefix">GH¢</span><input type="number" name="otherExpenses" class="form-control financial m-expense" min="0" step="0.01" placeholder="0.00" required></div></div>
